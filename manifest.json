{
  "manifest_version": 3,
  "name": "FocusFlow - Roam Less. Gather More.",
  "short_name": "FocusFlow",
  "version": "3.1.0",
  "description": "Your digital companion that helps you browse with purpose. Track focus time, build better habits, and watch your productivity grow through mastery stages.",
  "icons": {
    "16": "icons/icon.png",
    "32": "icons/icon.png",
    "48": "icons/icon.png",
    "128": "icons/icon.png"
  },
  "permissions": [
    "storage",
    "tabs",
    "activeTab",
    "scripting",
    "idle",
    "alarms",
    "notifications"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon.png",
      "32": "icons/icon.png",
      "48": "icons/icon.png",
      "128": "icons/icon.png"
    },
    "default_title": "FocusFlow - Check your progress"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/content-script.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "libs/vis-network.min.js",
        "libs/vis-network.min.css",
        "utils/vis-loader.js"
      ],
      "matches": ["<all_urls>"]
    }
  ],
  "minimum_chrome_version": "127"
}
