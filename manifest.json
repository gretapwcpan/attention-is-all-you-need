{
  "manifest_version": 3,
  "name": "FocusFlow - Roam Less. Discover More.",
  "short_name": "FocusFlow",
  "version": "3.1.0",
  "description": "Your digital companion that helps you browse with purpose. Track focus time, build better habits, and watch your productivity grow through mastery stages.",
  "icons": {
    "16": "icons/icon.png",
    "32": "icons/icon.png",
    "48": "icons/icon.png",
    "128": "icons/icon.png"
  },
  "permissions": [
    "storage",
    "tabs",
    "activeTab",
    "scripting",
    "idle",
    "alarms",
    "notifications"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon.png",
      "32": "icons/icon.png",
      "48": "icons/icon.png",
      "128": "icons/icon.png"
    },
    "default_title": "FocusFlow - Check your progress"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/content-script.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "libs/vis-network.min.js",
        "libs/vis-network.min.css",
        "utils/vis-loader.js",
        "utils/knowledge-storage.js",
        "utils/knowledge-graph.js",
        "utils/network-visualizer.js",
        "utils/ai-service.js",
        "utils/ai-summarizer.js",
        "utils/browsing-tracker.js",
        "utils/pdf-extractor.js",
        "utils/todo-ai-mapper.js",
        "utils/character-generator.js",
        "utils/character-storage.js",
        "utils/todo-storage.js",
        "utils/tamagotchi.js",
        "utils/storage.js",
        "utils/attention-tracker.js",
        "analytics/analytics.html",
        "analytics/analytics.css",
        "analytics/analytics.js",
        "popup/popup.html",
        "popup/popup.css",
        "popup/popup.js",
        "popup/todo-manager.html",
        "popup/todo-manager.css",
        "popup/todo-manager.js",
        "popup/coach-dialog.html",
        "popup/coach-dialog.css",
        "popup/coach-dialog.js"
      ],
      "matches": ["<all_urls>"]
    }
  ],
  "minimum_chrome_version": "127"
}
